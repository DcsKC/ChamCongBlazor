@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage

<div class="nav-menu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> Trang chủ
            </NavLink>
        </div>
        @if (UserRole != "Admin")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="checkinout">
                    <span class="oi oi-clock" aria-hidden="true"></span> Chấm công
                </NavLink>
            </div>
        }
        @if (UserRole == "Manager" || UserRole == "Admin")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="manage-employees">
                    <span class="oi oi-person" aria-hidden="true"></span> Quản lý nhân viên
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="historymanager">
                    <span class="oi oi-person" aria-hidden="true"></span> Quản lý lịch làm việc
                </NavLink>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="history">
                    <span class="oi oi-list-rich" aria-hidden="true"></span> Lịch sử chấm công
                </NavLink>
            </div>
        }
        <div class="nav-item px-3">   
            <NavLink class="nav-link" href="/logout">
                <span class="oi oi-list-rich" aria-hidden="true"></span> Đăng xuất
            </NavLink>
        </div>
        
    </nav>
</div>
@code {
    private string UserRole = string.Empty;
    [Inject] ProtectedSessionStorage SessionStorage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var userSession = await SessionStorage.GetAsync<UserSession>("UserSession");

        if (userSession.Success && userSession.Value != null)
        {
            UserRole = userSession.Value.UserRole;
        }
    }
    public class UserSession
    {
        public int UserId { get; set; }
        public String UserRole { get; set; } = string.Empty;
    }
}